	"item": [
		{
			"name": "BookNumber",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// 1. код 200\r",
							"pm.test(\"Статус-код 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// 2. сервер відповів \"OK\"\r",
							"pm.test(\"Статус-текст OK\", function () {\r",
							"    pm.response.to.have.status(\"OK\");\r",
							"});\r",
							"\r",
							"// 3.відповідь прийшла швидше, ніж за 2 секунди\r",
							"pm.test(\"Швидкість відповіді менше 2с\", function () {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
							"});\r",
							"\r",
							"// 4. конверт не порожній\r",
							"pm.test(\"Є заголовки відповіді\", function () {\r",
							"    pm.response.to.be.withBody;\r",
							"});\r",
							"\r",
							"// 5. XML файл\r",
							"pm.test(\"Тип відповіді - XML\", function () {\r",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/xml\");\r",
							"});\r",
							"\r",
							"// 6. дата відправки\r",
							"pm.test(\"На конверті є дата\", function () {\r",
							"    pm.response.to.have.header(\"Date\");\r",
							"});\r",
							"\r",
							"// 7. результат перевірки ISBN\r",
							"pm.test(\"Відповідь містить результат\", function () {\r",
							"    pm.expect(pm.response.text()).to.include(\"Result\");\r",
							"});\r",
							"\r",
							"// 8. \r",
							"pm.test(\"Є структура Envelope\", function () {\r",
							"    pm.expect(pm.response.text()).to.include(\"Envelope\");\r",
							"});\r",
							"\r",
							"// 9. сервер не написав нам про помилку\r",
							"pm.test(\"Немає помилок сервера\", function () {\r",
							"    pm.expect(pm.response.text()).to.not.include(\"faultcode\");\r",
							"});\r",
							"\r",
							"// довжина відповіді більше 0 символів\r",
							"pm.test(\"Лист не порожній\", function () {\r",
							"    pm.expect(pm.response.text().length).to.be.above(0);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
