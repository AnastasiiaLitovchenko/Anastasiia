		{
			"name": "FullBookInformation",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// 1. статус 200\r",
							"pm.test(\"1. Запит успішний (200 OK)\", () => { pm.response.to.have.status(200); });\r",
							"\r",
							"// 2. Час відповіді\r",
							"pm.test(\"2. Відповідь швидка\", () => { pm.expect(pm.response.responseTime).to.be.below(2000); });\r",
							"\r",
							"// 3. Перевірка формату XML\r",
							"pm.test(\"3. Формат відповіді XML\", () => { pm.response.to.be.withBody; });\r",
							"\r",
							"// 4. Назви книги\r",
							"pm.test(\"4. У відповіді є назва книги (sTitle)\", () => { pm.expect(pm.response.text()).to.include(\"sTitle\"); });\r",
							"\r",
							"// 5. Перевірка автора\r",
							"pm.test(\"5. У відповіді є автор (sAuthor)\", () => { pm.expect(pm.response.text()).to.include(\"sAuthor\"); });\r",
							"\r",
							"// 6. Перевірка заголовка сервера\r",
							"pm.test(\"6. Є заголовок Server\", () => { pm.response.to.have.header(\"Server\"); });\r",
							"\r",
							"// 7. Перевірка мови кодування\r",
							"pm.test(\"7. Кодування utf-8\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"utf-8\"); });\r",
							"\r",
							"// 8.(містить багато даних)\r",
							"pm.test(\"8. Докладна відповідь\", () => { pm.expect(pm.response.text().length).to.be.above(200); });\r",
							"\r",
							"// 9. Перевірка на відсутність помилок\r",
							"pm.test(\"9. Помилок SOAP не знайдено\", () => { pm.expect(pm.response.text()).to.not.include(\"Fault\"); });\r",
							"\r",
							"// 10. Перевірка структури XML\r",
							"pm.test(\"10. Присутній тег Body\", () => { pm.expect(pm.response.text()).to.include(\"soap:Body\"); });"
						],
